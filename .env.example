# Local platform / single-site env
# Copy to .env and edit. Never commit real secrets.

PLATFORM_MODE=1
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-local-secret-change-me

# Logging (console → journalctl -u platform on VPS). Optional: DJANGO_LOG_LEVEL, LOG_SQL=1
LOG_LEVEL=INFO

# Shared Telegram bot token (fallback if site admin token is empty)
TELEGRAM_BOT_TOKEN=

# Local Celery: tasks run in-process (no Redis needed)
CELERY_TASK_ALWAYS_EAGER=true
