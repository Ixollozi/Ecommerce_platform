# =============================================================================
# clothing_shop — Django multi-site platform
# Keep: themes/, store/, scripts/, sites.example/
# Ignore: local sites/ runtime, DBs, uploads, secrets, venvs, caches
# =============================================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.installed.cfg
wheels/
pip-wheel-metadata/
share/python-wheels/
.venv/
venv/
env/
ENV/
.env/
# setuptools / editable leftovers
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/

# ----- Virtualenv / tooling caches -----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ----- Secrets & local env -----
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
credentials.json
secrets.json

# ----- Django -----
*.log
local_settings.py
staticfiles/
/media/
media/

# SQLite (root single-site + journals)
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# ----- Platform local runtime (NEVER commit) -----
# Generated from sites.example/ by scripts/run_platform_local.ps1
# Contains per-host DBs, media, and machine-local config copies.
sites/

# ----- Celery / Redis (local) -----
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid
dump.rdb
*.pid

# ----- Node / Vite (if SPA source builds locally) -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.turbo/

# ----- OS -----
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- IDE / editors -----
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ----- Agents / browser QA clutter -----
.playwright-mcp/
playwright-report/
test-results/
.cursor/
.cursor/*.log

# ----- Theme shapes pipeline (organic / curated-like) -----
# Tracked: paths/, build scripts, organic_layouts.json, figma-pack.svg,
#          calibrate.html, approved/ (slots + calibrated snapshot),
#          templates partials from _build_*.
# Local only: inbox drops, QA shots, generated previews, static/shapes WIP.
themes/*/shapes/inbox/**
!themes/*/shapes/inbox/*.txt
themes/*/shapes/approved/qa-*
themes/*/shapes/approved/qa-*/
themes/*/shapes/mask-*.png
themes/*/shapes/qa-*.png
themes/*/shapes/qa-*.html
themes/*/shapes/[0-9][0-9]-*.svg
themes/*/shapes/hero-shapes.svg
themes/*/shapes/index.html
themes/*/shapes/mobile-calibrate.html
themes/*/shapes/mobile-preview.html
themes/*/shapes/mobile-pack.svg
themes/*/shapes/shop-calibrate.html
themes/*/shapes/_*.py
!themes/*/shapes/_build_hero.py
!themes/*/shapes/_build_figma_pack.py
!themes/*/shapes/_import_calibrated.py
!themes/*/shapes/_build_mobile_pack.py
!themes/*/shapes/_serve_mobile_calibrate.py
!themes/*/shapes/_serve_shop_calibrate.py
!themes/*/shapes/_build_shop_overlay.py
themes/*/static/shapes/**
!themes/*/static/shapes/organic_layouts.json
themes/*/static/img/_ref-*
themes/*/static/img/blob-*

# ----- Misc temp -----
*.tmp
*.temp
*.bak
*.orig
*.rej
.sass-cache/
